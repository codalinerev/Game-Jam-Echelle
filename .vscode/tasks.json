{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run LOVE Game",
            "type": "shell",
            "command": "/Applications/love.app/Contents/MacOS/love",
            "args": ["."],
            "options": {
                "cwd": "${workspaceFolder}"
            },       
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }           
       }
    ]       

}